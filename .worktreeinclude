# Gitignored files `wt step copy-ignored` copies into a new worktree.
# gitignore-style patterns; a file copies only if it is BOTH gitignored AND
# matched here. Tracked files (e.g. .env.e2e) are never touched.

# Secrets - auth 500s on the default secret without the real .env
.env
.env.*

# Android signing config. Without it `mise -C apps/mobile-flutter run apk-publish`
# refuses to build in a fresh worktree, which is exactly where a release is cut.
# It carries the store and key PASSWORDS in plaintext (the keystore file itself
# lives outside the repo), so this fans the release signing secret out to every
# live worktree - accepted for the same reason .env is, and it stays uncommittable
# because copy-ignored only ever touches gitignored files.
apps/mobile-flutter/app/android/key.properties

# Dependencies - skip the cold reinstall
node_modules/
.pnpm-store/

# Build / dev caches - reflink-cheap warm start
.nuxt/
.output/
.nitro/
.cache/
.data/
