{
  "module": "chat-content",
  "cases": [
    {
      "fn": "parseChatContent",
      "args": [
        ""
      ],
      "expected": []
    },
    {
      "fn": "extractMentions",
      "args": [
        ""
      ],
      "expected": []
    },
    {
      "fn": "decodeMentions",
      "args": [
        "",
        {
          "u-alice": "Alice",
          "u-john": "John",
          "u-john-doe": "John Doe"
        },
        "Someone"
      ],
      "expected": ""
    },
    {
      "fn": "parseChatContent",
      "args": [
        "plain text, nothing to see"
      ],
      "expected": [
        {
          "type": "text",
          "value": "plain text, nothing to see"
        }
      ]
    },
    {
      "fn": "extractMentions",
      "args": [
        "plain text, nothing to see"
      ],
      "expected": []
    },
    {
      "fn": "decodeMentions",
      "args": [
        "plain text, nothing to see",
        {
          "u-alice": "Alice",
          "u-john": "John",
          "u-john-doe": "John Doe"
        },
        "Someone"
      ],
      "expected": "plain text, nothing to see"
    },
    {
      "fn": "parseChatContent",
      "args": [
        "@<u-alice> hello"
      ],
      "expected": [
        {
          "type": "mention",
          "userId": "u-alice"
        },
        {
          "type": "text",
          "value": " hello"
        }
      ]
    },
    {
      "fn": "extractMentions",
      "args": [
        "@<u-alice> hello"
      ],
      "expected": [
        "u-alice"
      ]
    },
    {
      "fn": "decodeMentions",
      "args": [
        "@<u-alice> hello",
        {
          "u-alice": "Alice",
          "u-john": "John",
          "u-john-doe": "John Doe"
        },
        "Someone"
      ],
      "expected": "@Alice hello"
    },
    {
      "fn": "parseChatContent",
      "args": [
        "hi @<u-alice>"
      ],
      "expected": [
        {
          "type": "text",
          "value": "hi "
        },
        {
          "type": "mention",
          "userId": "u-alice"
        }
      ]
    },
    {
      "fn": "extractMentions",
